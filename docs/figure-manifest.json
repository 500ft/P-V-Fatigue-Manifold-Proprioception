{
  "schema_version": "1.0",
  "scope": "Computational result figures under data/gate0 and data/sim",
  "figures": [
    {
      "id": "gate0-cross-talk",
      "evidence_type": "simulation",
      "generator": "scripts/gate0_lumped_rc.py",
      "command": "python -m scripts.gate0_lumped_rc",
      "inputs": ["sim/plant.py"],
      "outputs": [
        "data/gate0/fig_crosstalk_vs_compliance.png",
        "data/gate0/fig_crosstalk_vs_freq.png",
        "data/gate0/fig_dc_independence.png"
      ],
      "boundary": "Lumped pneumatic-network model; no physical measurements"
    },
    {
      "id": "phase-a-plant",
      "evidence_type": "simulation",
      "generator": "scripts/phaseA_plant_demo.py",
      "command": "python -m scripts.phaseA_plant_demo",
      "inputs": ["sim/plant.py"],
      "outputs": [
        "data/sim/phaseA/fig_gate0_consistency.png",
        "data/sim/phaseA/fig_loop_area_vs_freq.png",
        "data/sim/phaseA/fig_pv_loops.png"
      ],
      "boundary": "Synthetic standard-linear-solid plant"
    },
    {
      "id": "phase-b-fatigue",
      "evidence_type": "simulation",
      "generator": "scripts/phaseB_fatigue_demo.py",
      "command": "python -m scripts.phaseB_fatigue_demo",
      "inputs": ["sim/fatigue.py", "sim/plant.py"],
      "outputs": [
        "data/sim/phaseB/fig_fatigue_trajectory.png",
        "data/sim/phaseB/fig_leak_sensitivity.png",
        "data/sim/phaseB/fig_onset_sensitivity.png",
        "data/sim/phaseB/fig_pressure_decay_over_life.png",
        "data/sim/phaseB/fig_pv_loops_over_life.png",
        "data/sim/phaseB/fig_rest_recovery.png"
      ],
      "boundary": "Assumed fatigue and recovery laws"
    },
    {
      "id": "study-1-health-indicators",
      "evidence_type": "simulation",
      "generator": "scripts/run_study1.py",
      "command": "python -m scripts.run_study1",
      "inputs": ["sim/fatigue.py", "pipeline/validation.py"],
      "outputs": [
        "data/sim/study1/fig_detector_comparison.png",
        "data/sim/study1/fig_hi_fusion_comparison.png",
        "data/sim/study1/fig_metric_fixtures.png",
        "data/sim/study1/fig_onset_generalization_gap.png",
        "data/sim/study1/fig_recovery_validation.png"
      ],
      "boundary": "Synthetic validation cohort and corruptions"
    },
    {
      "id": "study-2-proprioception-drift",
      "evidence_type": "simulation",
      "generator": "scripts/run_study2.py",
      "command": "python -m scripts.run_study2",
      "inputs": ["data/sim/phaseD/dataset.npz", "data/sim/phaseD/manifest.json"],
      "outputs": [
        "data/sim/phaseD/study2_fig1_drift.png",
        "data/sim/phaseD/study2_fig1_drift.pdf",
        "data/sim/phaseD/study2_fig2_static_vs_dynamic.png",
        "data/sim/phaseD/study2_fig2_static_vs_dynamic.pdf"
      ],
      "boundary": "Held-out identities come from the same synthetic generator"
    },
    {
      "id": "study-3-recalibration-policy",
      "evidence_type": "simulation",
      "generator": "scripts/run_study3.py",
      "command": "python -m scripts.run_study3",
      "inputs": ["data/sim/phaseD/dataset.npz", "data/sim/phaseD/manifest.json"],
      "outputs": [
        "data/sim/phaseD/study3_fig3_leading_indicator.png",
        "data/sim/phaseD/study3_fig3_leading_indicator.pdf",
        "data/sim/phaseD/study3_fig4_recal_tradeoff.png",
        "data/sim/phaseD/study3_fig4_recal_tradeoff.pdf"
      ],
      "boundary": "Policy evaluation is simulation-only"
    },
    {
      "id": "study-4-network-sensitivity",
      "evidence_type": "simulation",
      "generator": "scripts/run_study4.py",
      "command": "python -m scripts.run_study4",
      "inputs": ["sim/network.py", "sim/fatigue.py"],
      "outputs": [
        "data/sim/phaseD/study4_fig_crosstalk_sensitivity.png",
        "data/sim/phaseD/study4_fig_crosstalk_sensitivity.pdf"
      ],
      "boundary": "Sensitivity sweep of assumed network parameters"
    }
  ]
}
